# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
# Secondary dev-server build dir (NEXT_DIST_DIR) — keeps two servers on one
# checkout from corrupting each other's webpack cache.
/.next-claude/
# Pre-upgrade baseline build (NEXT_DIST_DIR) — kept so the Next 15/16 upgrade
# can be diffed against a known-good Next 14 build.
/.next-baseline/
/out/
next-env.d.ts

# NOTE: there is deliberately no `/build` rule here.
# It came from a create-react-app-style template and never applied to this
# project — Next.js builds into `/.next`, which is ignored above. All it did was
# hide `build/Doc6-Doc10`, the API list, architecture and security specs that
# CLAUDE.md points every session at ("APIs: build/Doc7 | Architecture: build/Doc8
# | Security: build/Doc9"). They are source, and they are now tracked.

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — NEVER commit secrets (Doc9 §16). Only the example template is tracked.
.env
.env.local
.env*.local
.env.development
.env.production

# typescript
*.tsbuildinfo

# testing / coverage
/coverage
/playwright-report
/test-results

# vercel
.vercel

# logs
*.log

# Dev-only local upload sink (R2 stand-in)
/public/uploads/

# QA harness session cache (dev cookies for seeded test numbers)
.qa-sessions.json
_shots/
public/_dx/

# Demo-seed photo cache — scripts/seed-demo-content.mjs re-downloads any missing
# file from Pexels, so these ~5MB of JPGs are a build artifact, not source.
scripts/.demo-photos/

# curl cookie jars from local API testing
cA.txt

# Upgrade before/after captures (screenshots + API payloads)
/_upgrade/

# Mobile screen reference set — every screen of the live app as a PNG, the
# input for the tablet/desktop layouts. Hundreds of images and fully
# regenerable: `node scripts/shot-screens.mjs`. The harness is tracked, the
# output is not.
/_screens/

# Shell geometry probes (scripts/shell-geometry.mjs) — regenerable.
/.shell-geo-*.json
