# ============================================================================
# HomzList — Environment Variables (Doc6 §11 / Doc7)
# Copy to .env.local and fill real values. NEVER commit .env.local.
# Rule: anything WITHOUT the NEXT_PUBLIC_ prefix is SERVER-ONLY and must
# never reach the browser bundle (Doc9 §16). service_role, webhook + API
# secrets, JWT secrets, OAuth secret, FCM service-account = server-only.
# ============================================================================

# --- App / subdomains (Doc6 §4) ---
NEXT_PUBLIC_APP_URL=https://homzlist.com
NEXT_PUBLIC_SELLER_URL=https://seller.homzlist.com
NEXT_PUBLIC_ADMIN_URL=https://account.homzlist.com
# Root cookie domain used for subdomain-scoped session isolation (leading dot).
COOKIE_DOMAIN=.homzlist.com
NODE_ENV=development

# --- Supabase (use @supabase/ssr — NOT deprecated auth-helpers) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # public ("publishable"); RLS protects data
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY — never sent to client
SUPABASE_PROJECT_REF=                   # project ref (from dashboard URL)
SUPABASE_DB_PASSWORD=                   # SERVER ONLY — human-run migrations
SUPABASE_ACCESS_TOKEN=                  # SERVER ONLY — Supabase CLI / management API

# --- Cloudflare R2 (images + CDN) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_CDN_URL=

# --- Redis (cache + BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379
# KV driver for auth/cache state: "redis" (default/prod) or "memory" (dev without
# a local Redis). BullMQ queues ALWAYS need real Redis regardless of this.
KV_DRIVER=redis

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                    # server only
RAZORPAY_WEBHOOK_SECRET=                # server only

# --- OTP provider (abstraction layer) ---
OTP_PROVIDER=dev                        # dev now; "msg91" at launch
OTP_DEV_FIXED_CODE=123456               # dev only
MSG91_AUTH_KEY=                         # added at launch
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@homzlist.com

# --- FCM (push — HTTP v1) ---
FCM_PROJECT_ID=homzlist-app
FCM_SERVICE_ACCOUNT_JSON=               # server only — full service-account JSON
NEXT_PUBLIC_FCM_VAPID_KEY=
NEXT_PUBLIC_FCM_SENDER_ID=

# --- Google OAuth (admin — via Supabase) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=             # server only

# --- Security / misc ---
JWT_ACCESS_SECRET=                      # server only — signs 15-min access tokens (Module 1)
JWT_REFRESH_SECRET=                     # server only — reserved (refresh is opaque + KV-tracked)
SENTRY_DSN=
