{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "homzlist-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:warm"],
      "port": 3000,
      "autoPort": true,
      "env": { "NEXT_DIST_DIR": ".next-claude" }
    },
    {
      "name": "homzlist-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "homzlist-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "homzlist-seller",
      "url": "http://seller.localhost:3000",
      "port": 3000
    },
    {
      "name": "homzlist-admin",
      "url": "http://account.localhost:3000",
      "port": 3000
    }
  ]
}
